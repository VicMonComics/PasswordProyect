<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasswordSave.ViewModels"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Views.GeneratorPage"
             x:DataType="viewmodels:GeneratorViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="0" Padding="0,14,0,0">

        <Label Grid.Row="0" Text="Generar contraseña" Style="{StaticResource TitleLabel}" FontSize="17" Padding="18,0,18,10" />

        <!-- Vista previa -->
        <Border Grid.Row="1" Margin="18,0,18,4" BackgroundColor="{StaticResource BgElevated}" Stroke="{StaticResource JadeSoft}" Padding="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="{Binding Password}"
                       FontFamily="SpaceGroteskMedium"
                       FontSize="15"
                       TextColor="{StaticResource Jade}"
                       LineBreakMode="CharacterWrap"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button Text="↻" WidthRequest="34" HeightRequest="34" Padding="0" FontSize="16"
                            BackgroundColor="{StaticResource BgCard}" TextColor="{StaticResource Jade}"
                            CornerRadius="10" Command="{Binding RegenerateCommand}" />
                    <Button Text="⧉" WidthRequest="34" HeightRequest="34" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource BgCard}" TextColor="{StaticResource Jade}"
                            CornerRadius="10" Command="{Binding CopyCommand}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
               Margin="18,0" VerticalOptions="End"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        <!-- Fortaleza -->
        <VerticalStackLayout Grid.Row="2" Margin="18,10,18,16" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar Grid.Column="0" Progress="{Binding StrengthFraction}" ProgressColor="{StaticResource Jade}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding StrengthLabel}" TextColor="{StaticResource Jade}" FontFamily="InterSemibold" FontSize="11" />
            <Label Text="{Binding CopiedMessage}" Style="{StaticResource SubtitleLabel}" FontSize="11"
                   IsVisible="{Binding CopiedMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <!-- Opciones -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Padding="18,0" Spacing="18">

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Longitud" Style="{StaticResource RowSubLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Length}" Style="{StaticResource RowNameLabel}" VerticalOptions="Center" />
                    </Grid>
                    <Slider Minimum="6" Maximum="32" Value="{Binding Length}" MinimumTrackColor="{StaticResource Jade}" ThumbColor="{StaticResource Jade}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Mayúsculas" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="A B C…" Style="{StaticResource RowSubLabel}" FontSize="10.5" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UseUppercase}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderSoft}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Minúsculas" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="a b c…" Style="{StaticResource RowSubLabel}" FontSize="10.5" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UseLowercase}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderSoft}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Números" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="2-9" Style="{StaticResource RowSubLabel}" FontSize="10.5" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UseNumbers}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderSoft}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Símbolos" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="! @ # $" Style="{StaticResource RowSubLabel}" FontSize="10.5" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UseSymbols}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="4" Padding="18,10">
            <Button Text="Usar esta contraseña" Clicked="OnUseClicked" />
        </VerticalStackLayout>

        <common:AdBlockView Grid.Row="5" AdsId="{x:Static common:AdUnitIds.Generator}" Margin="10,4" />

        <common:BottomTabBar Grid.Row="6" ActiveTab="Generador" TabSelected="OnTabSelected" />

    </Grid>
</ContentPage>
