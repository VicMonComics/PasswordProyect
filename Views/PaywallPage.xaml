<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordSave.Views.PaywallPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource GoldDim}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="0,0,0,20" RowSpacing="16">

        <Button Grid.Row="0" Text="✕" WidthRequest="28" HeightRequest="28" Padding="0"
                BackgroundColor="{StaticResource BgElevated}" TextColor="{StaticResource TextSecondary}"
                CornerRadius="14" FontSize="13"
                HorizontalOptions="End" Margin="0,14,16,0"
                Clicked="OnCloseClicked" />

        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="26,6,26,0" HorizontalOptions="Center">
            <Border WidthRequest="58" HeightRequest="58" Padding="0" Stroke="Transparent" StrokeShape="RoundRectangle 18" HorizontalOptions="Center" Background="{StaticResource GoldGradientBrush}">
                <Label Text="🛡" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource OnGold}" />
            </Border>
            <Label Text="Mi Llavero" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
            <Label Text="Seguridad sin límites para tu vida digital" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="2" Margin="18,0" Padding="0" BackgroundColor="{StaticResource BgElevated}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,60,70" RowSpacing="0">
                <Grid.Resources>
                    <Style TargetType="Label" x:Key="CellLabel">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        <Setter Property="HorizontalTextAlignment" Value="Center" />
                        <Setter Property="VerticalTextAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>

                <Label Grid.Row="0" Grid.Column="0" Text="Incluye" Style="{StaticResource CellLabel}" FontAttributes="Bold" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextTertiary}" />
                <Label Grid.Row="0" Grid.Column="1" Text="Free" Style="{StaticResource CellLabel}" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}" />
                <Label Grid.Row="0" Grid.Column="2" Text="Premium" Style="{StaticResource CellLabel}" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Contraseñas guardadas" Style="{StaticResource CellLabel}" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Row="1" Grid.Column="1" Text="20" Style="{StaticResource CellLabel}" />
                <Label Grid.Row="1" Grid.Column="2" Text="Ilimitadas" Style="{StaticResource CellLabel}" TextColor="{StaticResource Gold}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Carpetas personalizadas" Style="{StaticResource CellLabel}" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource CellLabel}" />
                <Label Grid.Row="2" Grid.Column="2" Text="Ilimitadas" Style="{StaticResource CellLabel}" TextColor="{StaticResource Gold}" />

                <Label Grid.Row="3" Grid.Column="0" Text="Alertas de filtraciones" Style="{StaticResource CellLabel}" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource CellLabel}" />
                <Label Grid.Row="3" Grid.Column="2" Text="✓" Style="{StaticResource CellLabel}" TextColor="{StaticResource Jade}" />

                <Label Grid.Row="4" Grid.Column="0" Text="Copia de seguridad" Style="{StaticResource CellLabel}" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource CellLabel}" />
                <Label Grid.Row="4" Grid.Column="2" Text="✓" Style="{StaticResource CellLabel}" TextColor="{StaticResource Jade}" />

                <Label Grid.Row="5" Grid.Column="0" Text="Soporte prioritario" Style="{StaticResource CellLabel}" HorizontalTextAlignment="Start" Padding="12,9" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource CellLabel}" />
                <Label Grid.Row="5" Grid.Column="2" Text="✓" Style="{StaticResource CellLabel}" TextColor="{StaticResource Jade}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="18,0" Padding="14" BackgroundColor="{StaticResource BgElevated}">
            <VerticalStackLayout Spacing="2">
                <Label Text="$49 MXN" Style="{StaticResource RowNameLabel}" FontSize="16" />
                <Label Text="al mes, cancela cuando quieras" Style="{StaticResource RowSubLabel}" />
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="4" Padding="22,0" Spacing="8">
            <Button Text="Comenzar prueba gratis de 7 días" Style="{StaticResource GoldButton}" Clicked="OnStartTrialClicked" />
            <Label Text="Sin cargos hasta que termine tu prueba" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" FontSize="11" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
