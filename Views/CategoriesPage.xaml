<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Views.CategoriesPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <Label Grid.Row="0" Text="Categorías" Style="{StaticResource TitleLabel}" Padding="18,14,18,6" />

        <!-- Banner premium -->
        <Border Grid.Row="1" Margin="18,0,18,12" Padding="13,12" BackgroundColor="{StaticResource GoldDim}" Stroke="{StaticResource GoldSoft}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0" Text="🛡" FontSize="20" TextColor="{StaticResource Gold}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label Text="Carpetas ilimitadas con Premium" Style="{StaticResource RowNameLabel}" />
                    <Label Text="Organiza por trabajo, banco, familia y más" Style="{StaticResource RowSubLabel}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Grid de carpetas: General es gratis, el resto queda bloqueado hasta Premium -->
        <Grid Grid.Row="2" Padding="18,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" VerticalOptions="Start">

            <Border Grid.Row="0" Grid.Column="0">
                <VerticalStackLayout Spacing="22">
                    <Border WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="{StaticResource JadeSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 10">
                        <Label Text="🗂" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="General" Style="{StaticResource RowNameLabel}" />
                        <Label Text="12 credenciales" Style="{StaticResource RowSubLabel}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Opacity="0.55">
                <VerticalStackLayout Spacing="22">
                    <Grid>
                        <Border WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="{StaticResource GoldDim}" Stroke="Transparent" StrokeShape="RoundRectangle 10">
                            <Label Text="🗂" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border WidthRequest="20" HeightRequest="20" Padding="0" BackgroundColor="{StaticResource BgBase}" Stroke="Transparent" StrokeShape="RoundRectangle 10" HorizontalOptions="End" VerticalOptions="Start">
                            <Label Text="🔒" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource Gold}" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Trabajo" Style="{StaticResource RowNameLabel}" />
                        <Label Text="Premium" Style="{StaticResource RowSubLabel}" TextColor="{StaticResource Gold}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Opacity="0.55">
                <VerticalStackLayout Spacing="22">
                    <Grid>
                        <Border WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="{StaticResource GoldDim}" Stroke="Transparent" StrokeShape="RoundRectangle 10">
                            <Label Text="🗂" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border WidthRequest="20" HeightRequest="20" Padding="0" BackgroundColor="{StaticResource BgBase}" Stroke="Transparent" StrokeShape="RoundRectangle 10" HorizontalOptions="End" VerticalOptions="Start">
                            <Label Text="🔒" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource Gold}" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Finanzas" Style="{StaticResource RowNameLabel}" />
                        <Label Text="Premium" Style="{StaticResource RowSubLabel}" TextColor="{StaticResource Gold}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Opacity="0.55">
                <VerticalStackLayout Spacing="22">
                    <Grid>
                        <Border WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="{StaticResource GoldDim}" Stroke="Transparent" StrokeShape="RoundRectangle 10">
                            <Label Text="🗂" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border WidthRequest="20" HeightRequest="20" Padding="0" BackgroundColor="{StaticResource BgBase}" Stroke="Transparent" StrokeShape="RoundRectangle 10" HorizontalOptions="End" VerticalOptions="Start">
                            <Label Text="🔒" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource Gold}" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Familia" Style="{StaticResource RowNameLabel}" />
                        <Label Text="Premium" Style="{StaticResource RowSubLabel}" TextColor="{StaticResource Gold}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <VerticalStackLayout Grid.Row="2" VerticalOptions="End" Padding="18,0,18,18">
            <Button Text="Ver PasswordSave Premium" Style="{StaticResource GoldButton}" Clicked="OnViewPremiumClicked" />
        </VerticalStackLayout>

        <common:BottomTabBar Grid.Row="3" ActiveTab="Categorías" TabSelected="OnTabSelected" />

    </Grid>
</ContentPage>
