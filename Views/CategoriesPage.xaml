<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasswordSave.ViewModels"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Views.CategoriesPage"
             x:Name="CategoriesPageRoot"
             x:DataType="viewmodels:CategoriesViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <Label Grid.Row="0" Text="Categorías" Style="{StaticResource TitleLabel}" Padding="18,14,18,6" />

        <!-- Banner premium: solo si no es premium -->
        <Border Grid.Row="1" Margin="18,0,18,12" Padding="13,12" BackgroundColor="{StaticResource GoldDim}" Stroke="{StaticResource GoldSoft}"
                IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0" Text="🛡" FontSize="20" TextColor="{StaticResource Gold}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label Text="Carpetas ilimitadas con Premium" Style="{StaticResource RowNameLabel}" />
                    <Label Text="Organiza por trabajo, banco, familia y más" Style="{StaticResource RowSubLabel}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Grid de carpetas con conteo real -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Categories}" Margin="14,0" VerticalOptions="Start">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CategoryCardItem">
                    <Border>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference CategoriesPageRoot}, Path=BindingContext.OpenCategoryCommand}" CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="22">
                            <Grid>
                                <Border x:Name="FolderIcon" WidthRequest="34" HeightRequest="34" Padding="0" Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource JadeSoft}">
                                    <Label Text="🗂" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Border WidthRequest="20" HeightRequest="20" Padding="0" Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource BgBase}" HorizontalOptions="End" VerticalOptions="Start"
                                        IsVisible="{Binding IsLocked}">
                                    <Label Text="🔒" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource Gold}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Name}" Style="{StaticResource RowNameLabel}" />
                                <Label Text="{Binding Count, StringFormat='{0} credenciales'}" Style="{StaticResource RowSubLabel}" IsVisible="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}" />
                                <Label Text="Premium" Style="{StaticResource RowSubLabel}" TextColor="{StaticResource Gold}" IsVisible="{Binding IsLocked}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" VerticalOptions="End" Padding="18,0,18,18" IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}">
            <Button Text="Ver PasswordSave Premium" Style="{StaticResource GoldButton}" Clicked="OnViewPremiumClicked" />
        </VerticalStackLayout>

        <common:BottomTabBar Grid.Row="3" ActiveTab="Categorías" TabSelected="OnTabSelected" />

    </Grid>
</ContentPage>
