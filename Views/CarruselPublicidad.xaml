<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Common.CarruselPublicidad">

    <!--
        Mezcla de las dos versiones: intenta descargar 5 imágenes
        promocionales reales de un servidor propio; si no hay internet (o
        la descarga falla), cae a 3 imágenes locales empacadas en el
        proyecto (Resources/Images/bn1.png, bn2.png, bn3.png) — esas ya
        viven en el proyecto, nunca se descargan. Sin gesto de toque, a
        propósito (decisión ya tomada).
    -->
    <Grid RowDefinitions="Auto,10">
        <Border Grid.Row="0" HeightRequest="50" Padding="0"
                BackgroundColor="{StaticResource BgElevated}" Stroke="{StaticResource BorderSoft}"
                StrokeShape="RoundRectangle 10">
            <CarouselView x:Name="Carousel" Loop="True" IndicatorView="Indicadores" HeightRequest="50">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="common:PublicidadItem">
                        <Image Source="{Binding Imagen}" Aspect="AspectFit"
                               HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Border>

        <IndicatorView x:Name="Indicadores" Grid.Row="1" HorizontalOptions="Center"
                       IndicatorColor="{StaticResource Border}" SelectedIndicatorColor="{StaticResource Jade}" />
    </Grid>
</ContentView>
