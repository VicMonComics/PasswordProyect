<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Common.AdBlockView">

    <!--
        El MTAdView de Android se agrega por código en el code-behind (no
        aquí en el XAML): el NuGet Plugin.MauiMTAdmob solo está referenciado
        para net10.0-android, así que declarar <ads:MTAdView> directo en
        este XAML compartido rompería el build de iOS. Ver AdBlockView.xaml.cs.
    -->
    <Grid x:Name="Container" HeightRequest="50">
        <common:CarruselPublicidad x:Name="FallbackCarousel" IsVisible="False" />
    </Grid>
</ContentView>
