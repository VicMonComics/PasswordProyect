<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasswordSave.ViewModels"
             x:Class="PasswordSave.Views.AddEditCredentialPage"
             x:DataType="viewmodels:AddEditCredentialViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- Topbar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10,14,14,10">
            <Button Grid.Column="0" Text="" ImageSource="flecha.png" WidthRequest="35" HeightRequest="40" FontAttributes="Bold" Padding="0" FontSize="28"
                    BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TitleLabel}" FontSize="16"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="" ImageSource="basura.png" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="14"
                    BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                    IsVisible="{Binding IsEditMode}"
                    Command="{Binding DeleteCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,4,18,18" Spacing="18">

                <!-- Hero -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border WidthRequest="54" HeightRequest="54" Padding="0" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource JadeSoft}" HorizontalOptions="Center">
                        <Label Text="{Binding AvatarInitial}" Style="{StaticResource AvatarLabel}" TextColor="{StaticResource Jade}" FontSize="20" />
                    </Border>
                    <Label Text="{Binding Category}" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- Banner de límite del plan Free alcanzado -->
                <Border Padding="13,12" BackgroundColor="{StaticResource GoldDim}" Stroke="{StaticResource GoldSoft}"
                        IsVisible="{Binding IsAtFreeLimit}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="🛡" FontSize="20" TextColor="{StaticResource Gold}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Llegaste al límite del plan Free" Style="{StaticResource RowNameLabel}" />
                            <Label Text="Hazte Premium para guardar contraseñas sin límite." Style="{StaticResource RowSubLabel}" />
                            <Button Text="Ver Premium" Style="{StaticResource GoldButton}" HeightRequest="38" FontSize="12"
                                    Clicked="OnViewPremiumClicked" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Nombre del sitio -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre del sitio" Style="{StaticResource RowSubLabel}" />
                    <Entry Text="{Binding SiteName}" Placeholder="Netflix, BBVA, Facebook…" />
                </VerticalStackLayout>

                <!-- Usuario -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuario o correo" Style="{StaticResource RowSubLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding Username}" Placeholder="usuario@correo.com" />
                        <Button Grid.Column="1" Text="⧉" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="14"
                                BackgroundColor="{StaticResource BgElevated}" TextColor="{StaticResource Jade}" CornerRadius="10"
                                Command="{Binding CopyUsernameCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Contraseña -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Contraseña" Style="{StaticResource RowSubLabel}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding Password}" IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}" Placeholder="Contraseña" />
                        <Button Grid.Column="1" Text="👁" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="14"
                                BackgroundColor="{StaticResource BgElevated}" TextColor="{StaticResource TextSecondary}" CornerRadius="10"
                                Command="{Binding TogglePasswordVisibilityCommand}" />
                        <Button Grid.Column="2" Text="↻" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="16"
                                BackgroundColor="{StaticResource BgElevated}" TextColor="{StaticResource Jade}" CornerRadius="10"
                                Command="{Binding GenerateNewPasswordCommand}" />
                        <Button Grid.Column="3" Text="⧉" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="14"
                                BackgroundColor="{StaticResource BgElevated}" TextColor="{StaticResource Jade}" CornerRadius="10"
                                Command="{Binding CopyPasswordCommand}" />
                    </Grid>
                    <ProgressBar Progress="{Binding StrengthFraction}" ProgressColor="{StaticResource Jade}" />
                    <Label Text="{Binding StrengthLabel}" TextColor="{StaticResource Jade}" FontFamily="InterSemibold" FontSize="11" />
                </VerticalStackLayout>

                <!-- Sitio web -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Sitio web" Style="{StaticResource RowSubLabel}" />
                    <Entry Text="{Binding Website}" Placeholder="https://…" Keyboard="Url" />
                </VerticalStackLayout>

                <!-- Categoría -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoría" Style="{StaticResource RowSubLabel}" />
                    <Picker ItemsSource="{Binding CategoryOptionsList}" SelectedItem="{Binding Category}"
                            TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource BgElevated}" />
                </VerticalStackLayout>

                <!-- Notas -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Notas" Style="{StaticResource RowSubLabel}" />
                    <Editor Text="{Binding Notes}" Placeholder="Notas opcionales…" AutoSize="TextChanges" MinimumHeightRequest="70"
                            TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource BgElevated}" />
                </VerticalStackLayout>

                <!-- Favorito -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="☆ Favorito" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsFavorite}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="18,10,18,20">
            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
