<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordSave.Views.PrivacyOverlayPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource BgPage}">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
        <Label Text="🛡" FontSize="46" TextColor="{StaticResource Jade}" HorizontalTextAlignment="Center" />
        <Label Text="PasswordSave" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
        <Label Text="Contenido oculto por seguridad" Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
