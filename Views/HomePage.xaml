<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PasswordSave.ViewModels"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.Views.HomePage"
             x:Name="HomePageRoot"
             x:DataType="viewmodels:HomeViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Topbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="18,14,18,6">
            <Label Grid.Column="0" Text="PasswordSave" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" Padding="0" StrokeShape="RoundRectangle 10">
                <Label Text="⚙" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- Buscador -->
        <Border Grid.Row="1" Style="{StaticResource SearchBarBorder}" Margin="18,4,18,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="🔍" TextColor="{StaticResource TextTertiary}" FontSize="13" VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Buscar credencial…"
                       BackgroundColor="Transparent"
                       FontSize="13.5" />
            </Grid>
        </Border>

        <!-- Chips de filtro -->
        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding Chips}"
                         SelectionMode="None"
                         HeightRequest="44"
                         Margin="14,0,0,8">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="7" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ChipItem">
                    <Button Text="{Binding Label}"
                            Style="{StaticResource ChipButton}"
                            Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.SelectChipCommand}"
                            CommandParameter="{Binding Label}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource JadeSoft}" />
                                <Setter Property="BorderColor" Value="{StaticResource Jade}" />
                                <Setter Property="TextColor" Value="{StaticResource Jade}" />
                                <Setter Property="FontFamily" Value="InterSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lista / estado vacío -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Credentials}"
                             IsVisible="{Binding HasResults}"
                             SelectionMode="None"
                             Margin="10,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CredentialListItem">
                        <Border Style="{StaticResource CredentialRowBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.OpenCredentialCommand}" CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="38" HeightRequest="38"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 11"
                                        Stroke="Transparent"
                                        BackgroundColor="{Binding AvatarColorHex, Converter={StaticResource HexColorConverter}}">
                                    <Label Text="{Binding AvatarInitial}"
                                           Style="{StaticResource AvatarLabel}"
                                           TextColor="{Binding AvatarTextColorHex, Converter={StaticResource HexColorConverter}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding SiteName}" Style="{StaticResource RowNameLabel}" />
                                    <Label Text="{Binding SubtitleMasked}" Style="{StaticResource RowSubLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsVaultEmpty}"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center"
                                  Padding="34,0"
                                  Spacing="16">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 26" Padding="0" HorizontalOptions="Center">
                    <Label Text="🔍" FontSize="34" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource Jade}" />
                </Border>
                <Label Text="Aún no guardas nada aquí" Style="{StaticResource TitleLabel}" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Text="Agrega tu primera contraseña y PasswordSave la protegerá con cifrado de extremo a extremo."
                       Style="{StaticResource SubtitleLabel}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsFilterEmpty}"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center"
                                  Padding="34,0">
                <Label Text="Sin resultados para este filtro." Style="{StaticResource SubtitleLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- FAB -->
            <Button Style="{StaticResource FabButton}"
                    Text="+"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,18,14"
                    Clicked="OnAddClicked" />
        </Grid>

        <!-- Barra inferior -->
        <common:BottomTabBar Grid.Row="4" x:Name="TabBar" ActiveTab="Inicio" TabSelected="OnTabSelected" />

    </Grid>
</ContentPage>
