<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta base de PasswordSave: fondo oscuro + acento verde.
        La app usa siempre este tema (no sigue el claro/oscuro del sistema)
        porque es la identidad visual elegida para el producto, no un
        "modo oscuro" opcional.
        Todo control debe tomar su color de aquí — nunca un color fijo
        (#RRGGBB) suelto dentro de una vista.
    -->

    <Color x:Key="Background">#0E1512</Color>
    <Color x:Key="Surface">#1A2420</Color>
    <Color x:Key="SurfaceAlt">#22302A</Color>
    <Color x:Key="Border">#2C3A33</Color>

    <Color x:Key="Primary">#34C77B</Color>
    <Color x:Key="PrimaryDark">#1F8F57</Color>
    <Color x:Key="OnPrimary">#06120C</Color>

    <Color x:Key="TextPrimary">#ECEDEA</Color>
    <Color x:Key="TextSecondary">#9AA6A0</Color>
    <Color x:Key="TextDisabled">#5B665F</Color>

    <Color x:Key="Danger">#E2574C</Color>
    <Color x:Key="OnDanger">#FDEDEB</Color>
    <Color x:Key="Success">#34C77B</Color>

    <!-- Brushes: para bindings que exigen Brush en vez de Color (algunos controles gráficos). -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />

</ResourceDictionary>
