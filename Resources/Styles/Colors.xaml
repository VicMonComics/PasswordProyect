<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta tomada tal cual de llavero-prototipo.html (:root del CSS).
        Todo control debe tomar su color de aquí — nunca un color fijo
        (#RRGGBB) suelto dentro de una vista.
    -->

    <!-- Fondos -->
    <Color x:Key="BgPage">#0A1615</Color>
    <Color x:Key="BgBase">#0E1A1A</Color>
    <Color x:Key="BgElevated">#152826</Color>
    <Color x:Key="BgCard">#1B302D</Color>
    <Color x:Key="BgCardHover">#213B37</Color>

    <!-- Bordes -->
    <Color x:Key="Border">#264541</Color>
    <Color x:Key="BorderSoft">#1D3532</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#EDF6F3</Color>
    <Color x:Key="TextSecondary">#9DBAB3</Color>
    <Color x:Key="TextTertiary">#6B8B84</Color>

    <!-- Acento principal: jade -->
    <Color x:Key="Jade">#22C58B</Color>
    <Color x:Key="JadeDim">#123C2D</Color>
    <Color x:Key="JadeSoft">#1A4536</Color>
    <Color x:Key="OnJade">#062018</Color>

    <!-- Acento premium: dorado -->
    <Color x:Key="Gold">#E4B45A</Color>
    <Color x:Key="GoldGradientStart">#F0C878</Color>
    <Color x:Key="GoldGradientEnd">#B9822C</Color>
    <Color x:Key="GoldDim">#3A2E17</Color>
    <Color x:Key="GoldSoft">#4A3B1E</Color>
    <Color x:Key="OnGold">#241804</Color>

    <!-- Estados -->
    <Color x:Key="Danger">#FF6B6B</Color>
    <Color x:Key="DangerDim">#3A1B1B</Color>

    <!-- Brushes: para bindings que exigen Brush en vez de Color, y gradientes. -->
    <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource BgPage}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="JadeBrush" Color="{StaticResource Jade}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GoldGradientStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource GoldGradientEnd}" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
