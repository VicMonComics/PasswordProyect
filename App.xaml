<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:PasswordSave.Common"
             x:Class="PasswordSave.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <common:InverseBoolConverter x:Key="InverseBoolConverter" />
            <common:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <common:HexColorConverter x:Key="HexColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
